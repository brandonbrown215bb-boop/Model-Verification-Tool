<UserControl x:Class="InventorValidator.UI.Controls.ChannelMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="380" d:DesignWidth="900"
             ClipToBounds="True">
    <Grid Background="{DynamicResource BgTertiaryBrush}">
        <Grid.RowDefinitions>
            <!-- Map Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Canvas Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Map Control Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Group Filters -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Zoom / Pan Buttons -->
                    <ColumnDefinition Width="*"/>
                    <!-- Legend Chips -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Group Filter Pills -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VIEW:" 
                               FontSize="10" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource FgMutedBrush}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"/>
                    <RadioButton x:Name="BtnAllGroups" Content="All Groups" Style="{StaticResource {x:Type ToggleButton}}"
                                 Height="24" Padding="8,0" Margin="0,0,4,0" IsChecked="True" Click="OnGroupFilterClicked"/>
                    <RadioButton x:Name="BtnFloor" Content="Floor" Style="{StaticResource {x:Type ToggleButton}}"
                                 Height="24" Padding="8,0" Margin="0,0,4,0" Click="OnGroupFilterClicked"/>
                    <RadioButton x:Name="BtnRoof" Content="Roof" Style="{StaticResource {x:Type ToggleButton}}"
                                 Height="24" Padding="8,0" Margin="0,0,4,0" Click="OnGroupFilterClicked"/>
                    <RadioButton x:Name="BtnSouthWall" Content="South Wall" Style="{StaticResource {x:Type ToggleButton}}"
                                 Height="24" Padding="8,0" Margin="0,0,4,0" Click="OnGroupFilterClicked"/>
                    <RadioButton x:Name="BtnNorthWall" Content="North Wall" Style="{StaticResource {x:Type ToggleButton}}"
                                 Height="24" Padding="8,0" Click="OnGroupFilterClicked"/>
                </StackPanel>

                <!-- Zoom Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="➕" ToolTip="Zoom In" Width="26" Height="24" Margin="0,0,4,0" Click="OnZoomInClicked"/>
                    <Button Content="➖" ToolTip="Zoom Out" Width="26" Height="24" Margin="0,0,4,0" Click="OnZoomOutClicked"/>
                    <Button Content="[ Fit ]" ToolTip="Fit to Window" Height="24" Padding="8,0" Margin="0,0,4,0" Click="OnFitToWindowClicked"/>
                    <Button Content="↺ Reset" ToolTip="Reset Zoom &amp; Pan" Height="24" Padding="8,0" Click="OnResetClicked"/>
                    <TextBlock x:Name="TxtZoomLevel" Text="100%" FontSize="11" Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Status Legend Chips -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="#2EA043" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,4,0">
                        <TextBlock Text="● Match" FontSize="10" FontWeight="Bold" Foreground="#2EA043"/>
                    </Border>
                    <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="#D29922" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,4,0">
                        <TextBlock Text="▲ Warning" FontSize="10" FontWeight="Bold" Foreground="#D29922"/>
                    </Border>
                    <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="#F85149" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,4,0">
                        <TextBlock Text="✖ Discrepancy" FontSize="10" FontWeight="Bold" Foreground="#F85149"/>
                    </Border>
                    <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="#CF222E" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,4,0">
                        <TextBlock Text="○ Missing" FontSize="10" FontWeight="Bold" Foreground="#CF222E"/>
                    </Border>
                    <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="#A371F7" BorderThickness="1" CornerRadius="2" Padding="6,2">
                        <TextBlock Text="◆ Extra" FontSize="10" FontWeight="Bold" Foreground="#A371F7"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Canvas Container -->
        <Border Grid.Row="1"
                Background="#0D1117"
                ClipToBounds="True"
                x:Name="CanvasContainer"
                MouseWheel="OnCanvasMouseWheel"
                MouseDown="OnCanvasMouseDown"
                MouseMove="OnCanvasMouseMove"
                MouseUp="OnCanvasMouseUp">
            <Canvas x:Name="MapCanvas">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="1.0" ScaleY="1.0"/>
                        <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
            </Canvas>
        </Border>
    </Grid>
</UserControl>
